# Copy to .env. Local default: SQLite file web/backend/forge.db
# Supabase: Project Settings -> Database -> Connection string (URI), driver postgresql+psycopg
# DATABASE_URL=postgresql+psycopg://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
JWT_SECRET=change-this-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
DEMO_MODE=true
ADMIN_EMAIL=reviewer@gehu.ac.in
ADMIN_PASSWORD=
# Optional free GitHub token for more API calls per hour
GITHUB_TOKEN=
AUTO_CHECKS=true
